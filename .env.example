# Erebus runs locally without cloud credentials. Copy this file to `.env` only
# when you need to override a local setting. Never commit secrets.

# Optional state directory. The default is ~/.erebus.
# EREBUS_HOME=C:\Users\you\.erebus

# Optional server bind overrides.
# T3CODE_HOST=127.0.0.1
# T3CODE_PORT=3773

# Optional desktop development server.
# VITE_DEV_SERVER_URL=http://127.0.0.1:5173

# Legacy T3CODE_* runtime names remain supported while the upstream base is
# migrated. Erebus ships with cloud relay and hosted-app integration disabled.
